        <!-- Scripts -->
        <script>
            if ('serviceWorker' in navigator) {
                navigator.serviceWorker.register('/sw.js').catch(() => {});
            }

            const homeSection = document.getElementById('home-section');
            const managerSection = document.getElementById('manager-section');
            const employeeSection = document.getElementById('employee-section');
            const pinModal = document.getElementById('pin-modal');
            const pinInput = document.getElementById('pin-input');
            const MANAGER_PIN = '123456';

            function showPinModal() {
                pinModal.classList.add('active');
                pinInput.value = '';
                // Animation reset
                const content = pinModal.querySelector('.modal-content');
                content.style.animation = 'none';
                content.offsetHeight; /* trigger reflow */
                content.style.animation = 'modalSlideUp 0.3s cubic-bezier(0.16, 1, 0.3, 1)';

                setTimeout(() => pinInput.focus(), 100);
            }

            function closePinModal() {
                pinModal.classList.remove('active');
            }

            function verifyPin() {
                if (pinInput.value === MANAGER_PIN) {
                    closePinModal();
                    localStorage.removeItem('bcauto_branch_locked'); // Clear lock for HO managers
                    showManagerSection();
                } else {
                    pinInput.style.borderColor = 'var(--danger)';
                    pinInput.classList.add('shake');
                    setTimeout(() => {
                        alert('รหัส�S��า�"�ม���ูก�"�0อ�!');
                        pinInput.value = '';
                        pinInput.style.borderColor = 'var(--surface-200)';
                    }, 100);
                }
            }

            pinInput.addEventListener('keypress', function (e) {
                if (e.key === 'Enter') verifyPin();
            });

            function showManagerSection() {
                switchSection(homeSection, managerSection);
            }

            function showEmployeeSection() {
                switchSection(homeSection, employeeSection);
            }

            function goHome() {
                // Find active section
                const active = document.querySelector('.view-section.active');
                switchSection(active, homeSection);
            }

            function switchSection(from, to) {
                from.classList.remove('active');
                // Small ripple delay if needed, but instant is better for web
                setTimeout(() => {
                    to.classList.add('active');
                }, 50);
            }

            function selectBranchAndGo(branch, url) {
                localStorage.setItem('bcauto_branch', branch);
                window.location.href = url;
            }
        </script>
    </body>
