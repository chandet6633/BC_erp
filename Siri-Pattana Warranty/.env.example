PORT=3000

# NocoDB example: http://192.168.1.50:8080
NOCODB_URL=
NOCODB_TOKEN=

# Use the NocoDB table ID when possible. A table name can work if your NocoDB API accepts it.
NOCODB_WARRANTIES_TABLE=warranties
NOCODB_PRODUCTS_TABLE=products
NOCODB_FILM_OPTIONS_TABLE=film_options
NOCODB_INSTALL_CENTERS_TABLE=install_centers
NOCODB_ADMIN_USERS_TABLE=admin_users
NOCODB_VEHICLE_MODELS_TABLE=vehicle_models

# Change before public production hosting.
SESSION_SECRET=

# Optional fallback admin for Docker deployments. NocoDB AdminUsers still works too.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=Siri Pattana Admin
