PORT=3001
APP_BASE_URL=https://warranty.bcauto.work

# Required in production. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# NocoDB production backend. Leave blank only if you intentionally use the Docker data volume fallback.
NOCODB_URL=
NOCODB_TOKEN=
NOCODB_WARRANTIES_TABLE=warranties
NOCODB_PRODUCTS_TABLE=products
NOCODB_FILM_OPTIONS_TABLE=film_options
NOCODB_INSTALL_CENTERS_TABLE=install_centers
NOCODB_ADMIN_USERS_TABLE=admin_users
NOCODB_VEHICLE_MODELS_TABLE=vehicle_models

# Optional fallback admin for deployments without NocoDB admin users.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=Siri Pattana Admin
